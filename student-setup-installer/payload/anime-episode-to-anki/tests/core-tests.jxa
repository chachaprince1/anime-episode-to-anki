ObjC.import("Foundation");

function readText(path) {
  return ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, null));
}

function assert(condition, message) {
  if (!condition) throw new Error(message);
}

function run(argv) {
  var corePath = argv[argv.length - 1];
  eval(readText(corePath));
  var Core = globalThis.JYACore;

  var particle = Core.applyFilters([{jpdbId: "2028920", spelling: "は", reading: "は", occurrences: 12}], Core.DEFAULT_FILTERS, [])[0];
  assert(!particle.included && particle.filterReason === "Particle", "standalone particle should be removed");

  var containingParticle = Core.applyFilters([{jpdbId: "999", spelling: "花火", reading: "はなび", occurrences: 1}], Core.DEFAULT_FILTERS, [])[0];
  assert(containingParticle.included, "a content word containing particle kana should remain");

  var laugh = Core.applyFilters([{jpdbId: "1514990", spelling: "ハハ", reading: "はは", occurrences: 1}], Core.DEFAULT_FILTERS, [])[0];
  var mother = Core.applyFilters([{jpdbId: "1514990", spelling: "母", reading: "はは", occurrences: 1}], Core.DEFAULT_FILTERS, [])[0];
  assert(!laugh.included && mother.included, "vocalization filtering must match ID and spelling");

  var frequent = Core.applyFilters([{jpdbId: "1", spelling: "語", reading: "ご", occurrences: 1, yomitanFrequencyRank: [30001, 12000]}], {skipFrequencyAbove20k: true}, [])[0];
  assert(frequent.included, "frequency filtering should use the lowest Yomitan rank");
  var rare = Core.applyFilters([{jpdbId: "2", spelling: "語", reading: "ご", occurrences: 1, yomitanFrequencyRank: [30001, 45001]}], {skipFrequencyAbove30k: true}, [])[0];
  assert(!rare.included && rare.filterReason === "Frequency >30k", "frequency threshold should use Yomitan ranks");
  var tenK = Core.applyFilters([{jpdbId: "3", spelling: "語", reading: "ご", occurrences: 1, yomitanFrequencyRank: 10001}], {skipFrequencyAbove10k: true}, [])[0];
  assert(!tenK.included && tenK.filterReason === "Frequency >10k", "10k frequency threshold should remove ranks above 10k");

  var honorific = Core.applyFilters([{jpdbId: "4", spelling: "様", reading: "さま", occurrences: 1}], {skipTitleHonorifics: true}, [])[0];
  assert(!honorific.included && honorific.filterReason === "Title honorific", "title honorifics should be removed by their filter");
  var position = Core.applyFilters([{jpdbId: "5", spelling: "部長", reading: "ぶちょう", occurrences: 1}], {skipTitlePositions: true}, [])[0];
  assert(!position.included && position.filterReason === "Title position", "title positions should be removed by their filter");
  var migrated = Core.mergeSettings({filters: {skipHonorifics: true}});
  assert(migrated.filters.skipTitleHonorifics && migrated.filters.skipTitlePositions, "legacy title filter should migrate to both title filters");

  var grammar = Core.applyFilters([{jpdbId: "1007340", spelling: "だけ", reading: "だけ", occurrences: 1}], Core.DEFAULT_FILTERS, [])[0];
  assert(grammar.included, "semantic grammar should remain by default");

  var chosen = Core.chooseYomitanFields([{reading: "べつ"}, {reading: "タカギ", glossary: "name"}], "たかぎ");
  assert(chosen.glossary === "name", "reading matching should normalize katakana");

  var kanaOnly = Core.chooseYomitanFields([{expression: "する", reading: "", glossary: "do"}], "する", "する");
  assert(kanaOnly.glossary === "do", "empty Yomitan reading should fall back to a kana-only expression");

  var format = {fields: {Front: {value: "{expression}"}, Back: {value: "{reading}<br>{glossary}"}}};
  var markers = Core.extractMarkers(format);
  assert(markers.indexOf("expression") >= 0 && markers.indexOf("reading") >= 0 && markers.indexOf("glossary") >= 0, "format markers should be discovered");
  var fields = Core.renderFormatFields(format, {expression: "高木", reading: "たかぎ", glossary: "Takagi"});
  assert(fields.Front === "高木" && fields.Back === "たかぎ<br>Takagi", "Yomitan markers should render into fields");

  var tsv = Core.notesToTsv([{modelName: "Basic", deckName: "JPDB", tags: ["jpdb"], fields: {Front: "高木", Back: "line 1\nline 2"}}]);
  assert(tsv.indexOf("#separator:tab") === 0 && tsv.indexOf("line 1 line 2") >= 0, "TSV should have Anki headers and no field newlines");

  console.log("Core tests passed");
}
